// Shared linker policy for the Cangjie iOS staticlib.
// ios/scripts/build_simulator.sh writes Config/Cangjie.local.xcconfig
// with the SDK .a list, section.o, and cjstart.o before xcodebuild.
//
// Order required by the 1.1.3 cross-compile page:
//   $CANGJIE_HOME/lib/<ios lib>/section.o
//   $CANGJIE_HOME/lib/<ios lib>/cjstart.o
//   -lc++
// then Dead Code Stripping = No (set below).
// Xcode 15 may also need -Wl,-no_compact_unwind (added by the script).
// https://cj-docs.gitcode.com/zh/1.1.3/dev-guide/source_zh_cn/compile_and_build/cross_compilation.html

DEAD_CODE_STRIPPING = NO
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
ENABLE_BITCODE = NO

#include? "Cangjie.local.xcconfig"
